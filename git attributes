# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf diff=python
*.pyw text eol=lf diff=python
*.pyx text eol=lf diff=python
*.pxd text eol=lf diff=python
*.pyi text eol=lf diff=python

# Python compiled files
*.pyc binary
*.pyo binary
*.pyd binary

# Jupyter Notebooks
*.ipynb text eol=lf linguist-documentation

# Data files
*.csv text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf

# Documentation
*.md text eol=lf linguist-documentation
*.rst text eol=lf linguist-documentation
LICENSE text eol=lf

# Configuration files
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.toml text eol=lf
requirements*.txt text eol=lf
setup.py text eol=lf
setup.cfg text eol=lf
pyproject.toml text eol=lf
MANIFEST.in text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Git files
.gitignore text eol=lf
.gitattributes text eol=lf
.gitmodules text eol=lf

# Docker files
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
.dockerignore text eol=lf

# Binary files
*.pkl binary
*.pickle binary
*.h5 binary
*.hdf5 binary
*.npy binary
*.npz binary
*.joblib binary

# Model files
*.pt binary
*.pth binary
*.model binary
*.onnx binary
*.pb binary

# Image files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary

# Archive files
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.7z binary
*.rar binary

# Database files
*.db binary
*.sqlite binary
*.sqlite3 binary

# Excel and Office files
*.xlsx binary
*.xls binary
*.xlsm binary
*.doc binary
*.docx binary
*.ppt binary
*.pptx binary
*.pdf binary

# Export diff and merge drivers
*.csv merge=union

# Linguist overrides for accurate language statistics
*.ipynb linguist-documentation
*.md linguist-documentation
*.txt linguist-documentation

